{
  "name": "vutbr/oidc-client",
  "type": "library",
  "description": "OAuth 2.1 / OpenID Connect client for VUT Auth Provider",
  "keywords": ["oauth2", "oauth2.1", "openid", "oidc", "vut"],
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Pavel Witassek",
      "email": "pavel.witassek@vut.cz"
    },
    {
      "name": "Patrik Sehnoutek",
      "email": "patrik.sehnoutek@vut.cz"
    }
  ],
  "autoload": {
    "psr-4": {
      "Vut2\\Component\\OpenIDConnectClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vut2\\Component\\OpenIDConnectClient\\Examples\\": "examples/",
      "Vut2\\Component\\OpenIDConnectClient\\Test\\": "tests/"
    }
  },
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.15.2 || ^8.0.1",
    "guzzlehttp/psr7": "^2.12.3 || ^3.0",
    "lcobucci/clock": "^2.0 || ^3.0",
    "lcobucci/jwt": "^4.3 || ^5.0",
    "league/oauth2-client": "^2.8.1",
    "phpseclib/phpseclib": "^3.0.58 || ^4.0.3",
    "psr/cache": "^1.0 || ^2.0 || ^3.0",
    "psr/http-client": "^1.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "conflict": {
    "paragonie/random_compat": "<2.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpunit/phpunit": "^9.6.33 || ^10.5.62 || ^11.5.50 || ^12.5.8",
    "spaze/phpstan-disallowed-calls": "^4.0"
  },
  "scripts": {
    "phpstan": "vendor/bin/phpstan --memory-limit=512M --ansi analyse --configuration phpstan.neon",
    "phpunit": "phpunit --log-junit phpunit-report.xml",
    "test": [
      "composer audit",
      "@phpstan",
      "@phpunit"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
